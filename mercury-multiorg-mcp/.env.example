# Example environment for mercury-multiorg-mcp. Placeholders only.
# Copy to a private location; a file named `.env` is gitignored repo-wide.
# One READ-ONLY Mercury API token per organization, named by `token_env`
# in your entity registry. Tokens look like: secret-token:mercury_production_...
MERCURY_TOKEN_ACME_MAIN=
MERCURY_TOKEN_ACME_OPS=

# Path to your private entity registry (or pass --entities on the command line).
MERCURY_ENTITIES_FILE=

# Optional. Default https://api.mercury.com ; use https://api-sandbox.mercury.com
# with sandbox-created tokens.
# MERCURY_API_BASE=
